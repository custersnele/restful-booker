    {
      "name": "5. Boekingsdetails bekijken",
      "item": [
        {
          "name": "GetBooking - bestaande booking (positief)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response bevat verwachte velden en waarden', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.firstname).to.eql(pm.collectionVariables.get('bookingFirstname'));",
                  "    pm.expect(json).to.have.property('lastname');",
                  "    pm.expect(json).to.have.property('totalprice');",
                  "    pm.expect(json).to.have.property('depositpaid');",
                  "    pm.expect(json.bookingdates).to.have.property('checkin');",
                  "    pm.expect(json.bookingdates).to.have.property('checkout');",
                  "});",
                  "",
                  "// De API heeft een opzettelijke vertraging van ~3 seconden op dit endpoint",
                  "pm.test('Response duurt minstens 3 seconden (opzettelijke vertraging)', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.above(2900);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking/{{bookingId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking",
                "{{bookingId}}"
              ]
            }
          },
          "response": []
        },
