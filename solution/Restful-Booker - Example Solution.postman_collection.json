    {
      "name": "6. Boeking aanmaken",
      "item": [
        {
          "name": "CreateBooking - geldige data (positief)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response bevat bookingid en opgeslagen data', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.bookingid).to.exist;",
                  "    pm.expect(json.booking.firstname).to.eql(pm.collectionVariables.get('bookingFirstname'));",
                  "    pm.expect(json.booking.totalprice).to.eql(150);",
                  "    pm.collectionVariables.set('bookingId', json.bookingid);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"{{bookingFirstname}}\",\n  \"lastname\": \"Doe\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-06-01\",\n    \"checkout\": \"2026-06-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
